<Window x:Class="BicycleShop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров - BicycleShop" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" FontFamily="Arial"
        Icon="/Images/icon.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#6A5ACD">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- Логотип (сохраняет пропорции благодаря Stretch="Uniform") -->
                    <!-- Пока файла нет, картинка просто не отрисуется, текст сместится влево -->
                    <Image Source="/Images/icon.ico" Height="35" Stretch="Uniform" Margin="0,0,15,0"/>
            
                    <TextBlock Text="Магазин велосипедов" Foreground="White" FontSize="18" FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="UserInfoText" Foreground="White" FontSize="14" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </Grid>
        </Border>
        
        <!-- Список товаров -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Products}" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 Background="#F0F0F0" BorderThickness="0" Padding="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Контейнер для одного товара -->
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="5" CornerRadius="5" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <!-- Если скидка > 15%, фон #483D8B (темно-фиолетовый) -->
                                    <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                                        <Setter Property="Background" Value="#483D8B"/>
                                    </DataTrigger>
                                    
                                    <!-- Если товара нет на складе И скидка не > 15%, фон серый -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOutOfStock}" Value="True"/>
                                            <Condition Binding="{Binding IsHighDiscount}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#D3D3D3"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фото -->
                            <Image Source="{Binding PhotoPath}" Width="120" Height="90" Stretch="Uniform" Grid.Column="0"/>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding CategoryName, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                                    <Run Text=" | " FontWeight="Bold" FontSize="14"/>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                                </TextBlock>
                                
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#555555" Margin="0,5"/>
                                <TextBlock Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}" FontSize="12"/>
                                <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}" FontSize="12"/>
                                
                                <!-- Цена -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <!-- Старая цена (зачеркнутая, красная) видна только если есть скидка -->
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="Red" 
                                               TextDecorations="Strikethrough" Margin="0,0,10,0" FontSize="13"
                                               Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <!-- Итоговая цена -->
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:C}}" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                                
                                <TextBlock FontSize="12" Margin="0,2,0,0">
                                    <Run Text="На складе: "/>
                                    <Run Text="{Binding QuantityInStock, Mode=OneWay}"/>
                                    <Run Text="{Binding UnitName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Скидка справа -->
                            <Border Grid.Column="2" Background="#4B0082" CornerRadius="5" VerticalAlignment="Center" Padding="10,5">
                                <TextBlock Text="{Binding DiscountDisplay}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
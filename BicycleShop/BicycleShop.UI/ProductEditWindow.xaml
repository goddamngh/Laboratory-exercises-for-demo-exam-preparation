<Window x:Class="BicycleShop.UI.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="650" Width="800"
        WindowStartupLocation="CenterScreen" FontFamily="Arial" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Фото -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Height="200" Margin="0,0,0,10">
                <Image Source="{Binding CurrentImagePath, Converter={StaticResource ImageSourceConverter}}" Stretch="Uniform"/>
            </Border>
            
            <Button Content="Выбрать фото" Height="30" Click="SelectPhoto_Click" Margin="0,0,0,10"/>
            
            <TextBlock Text="ID товара:" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Id}" IsReadOnly="True" Background="#EEEEEE" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Правая колонка: Поля -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Наименование:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Артикул:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10" IsReadOnly="True"/>

                <TextBlock Text="Категория:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedItem="{Binding SelectedCategory}" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Производитель:" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Manufacturers}" DisplayMemberPath="ManufacturerName" SelectedItem="{Binding SelectedManufacturer}" Height="25" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Поставщик:" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="SupplierName" SelectedItem="{Binding SelectedSupplier}" Height="25" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Цена:" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Кол-во на складе:" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding QuantityInStock, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Скидка (%):" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ValidDiscount, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Единица измерения:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="UnitName" SelectedItem="{Binding SelectedUnit}" Height="25" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                            Background="#4B0082" Foreground="White" Width="120" Height="35" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                            Width="120" Height="35"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>